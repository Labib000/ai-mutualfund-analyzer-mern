{
    "name": "@hisaab/server",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch --clear-screen=false --include ../.env --env-file-if-exists=../.env src/index.ts",
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@hisaab/shared": "*",
        "express": "^5.3.0",
        "helmet": "^8.3.0",
        "mongoose": "^9.11.4",
        "pino": "^10.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^24.0.0",
        "@types/supertest": "^7.2.1",
        "mongodb-memory-server": "^11.3.0",
        "supertest": "^7.3.1",
        "tsx": "^4.23.15",
        "vitest": "^5.1.0"
    },
    "config": {
        "mongodbMemoryServer": {
            "version": "8.0.15"
        }
    }
}
