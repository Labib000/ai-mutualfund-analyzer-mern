{
    "uid": "hisaab-load",
    "title": "Hisaab load test",
    "tags": ["hisaab"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "5s",
    "time": {
        "from": "now-15m",
        "to": "now"
    },
    "editable": true,
    "graphTooltip": 1,
    "panels": [
        {
            "type": "row",
            "title": "Overview (server)",
            "id": 1,
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            },
            "panels": []
        },
        {
            "type": "stat",
            "title": "Requests / s",
            "id": 2,
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 0,
                "y": 1
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps"
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "colorMode": "value",
                "graphMode": "area",
                "textMode": "auto"
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum(rate(hisaab_http_request_duration_seconds_count{route=~\"/api/.*\"}[$__rate_interval]))",
                    "refId": "A"
                }
            ]
        },
        {
            "type": "stat",
            "title": "p95 latency (all API)",
            "id": 3,
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 6,
                "y": 1
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "s"
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "colorMode": "value",
                "graphMode": "area",
                "textMode": "auto"
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(hisaab_http_request_duration_seconds_bucket{route=~\"/api/.*\"}[$__rate_interval])))",
                    "refId": "A"
                }
            ]
        },
        {
            "type": "stat",
            "title": "5xx rate",
            "id": 4,
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 12,
                "y": 1
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit"
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "colorMode": "value",
                "graphMode": "area",
                "textMode": "auto"
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "(sum(rate(hisaab_http_request_duration_seconds_count{route=~\"/api/.*\",status=\"5xx\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(hisaab_http_request_duration_seconds_count{route=~\"/api/.*\"}[$__rate_interval])), 1e-9)",
                    "refId": "A"
                }
            ]
        },
        {
            "type": "stat",
            "title": "Event-loop lag p99",
            "id": 5,
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 18,
                "y": 1
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "s"
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "colorMode": "value",
                "graphMode": "area",
                "textMode": "auto"
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "nodejs_eventloop_lag_p99_seconds{job=\"hisaab\"}",
                    "refId": "A"
                }
            ]
        },
        {
            "type": "row",
            "title": "k6 (what the client sees)",
            "id": 6,
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 5
            },
            "panels": []
        },
        {
            "type": "timeseries",
            "title": "k6 requests / s",
            "id": 7,
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "Pushed by k6 during npm run load. Empty when no test is running.",
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 0,
                "y": 6
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 10,
                        "showPoints": "never",
                        "spanNulls": true,
                        "stacking": {
                            "mode": "none"
                        }
                    }
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "calcs": ["mean", "max", "lastNotNull"]
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum by (name) (rate(k6_http_reqs_total[$__rate_interval]))",
                    "legendFormat": "{{name}}",
                    "refId": "A"
                }
            ]
        },
        {
            "type": "timeseries",
            "title": "k6 p95 latency by request",
            "id": 8,
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "",
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 8,
                "y": 6
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 10,
                        "showPoints": "never",
                        "spanNulls": true,
                        "stacking": {
                            "mode": "none"
                        }
                    }
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "calcs": ["mean", "max", "lastNotNull"]
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "max by (name) (k6_http_req_duration_p95)",
                    "legendFormat": "p95 {{name}}",
                    "refId": "A"
                },
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "max by (name) (k6_http_req_duration_p99)",
                    "legendFormat": "p99 {{name}}",
                    "refId": "B"
                }
            ]
        },
        {
            "type": "timeseries",
            "title": "k6 errors and virtual users",
            "id": 9,
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "Error rate = failed requests \u00f7 all requests (0\u2013100%). VUs (right axis) = virtual users k6 needed to keep the arrival rate.",
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 16,
                "y": 6
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit",
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 10,
                        "showPoints": "never",
                        "spanNulls": true,
                        "stacking": {
                            "mode": "none"
                        }
                    }
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "VUs"
                        },
                        "properties": [
                            {
                                "id": "unit",
                                "value": "short"
                            },
                            {
                                "id": "custom.axisPlacement",
                                "value": "right"
                            }
                        ]
                    }
                ]
            },
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "calcs": ["mean", "max", "lastNotNull"]
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "(sum(rate(k6_http_reqs_total{expected_response=\"false\"}[$__rate_interval])) or vector(0)) / sum(rate(k6_http_reqs_total[$__rate_interval]))",
                    "legendFormat": "error rate",
                    "refId": "A"
                },
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum(k6_vus)",
                    "legendFormat": "VUs",
                    "refId": "B"
                }
            ]
        },
