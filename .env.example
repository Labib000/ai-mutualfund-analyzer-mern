# --- App ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173

# --- Logging ---
# LOG_LEVEL=info
# Also write logs to a file (from the repo root). Default in development: logs/server.log. Empty = off.
# LOG_FILE=logs/server.log

# --- Database (MongoDB Atlas) ---
# Atlas → Connect → Drivers. Put the database name (hisaab) after ".net/".
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/hisaab?retryWrites=true&w=majority&appName=Cluster0

# --- Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ---
# Required, at least 32 characters. Signs session cookies and email links.
SESSION_SECRET=
# hPanel cron sends this as the X-Cron-Secret header to /internal/jobs/*. Unset = job endpoints are off.
CRON_SECRET=

# --- NAV data (defaults shown) ---
# AMFI_NAV_URL=https://www.amfiindia.com/spages/NAVAll.txt
# AMFI_TIMEOUT_SECONDS=60
# MFAPI_BASE_URL=https://api.mfapi.in
# MFAPI_TIMEOUT_SECONDS=15

# --- AI ---
AI_PROVIDER=groq
# Free key from https://console.groq.com/keys. Without one, the AI features say they're unavailable.
AI_API_KEY=
# Defaults shown:
# AI_MODEL=openai/gpt-oss-120b
# AI_REASONING_EFFORT=low        # "none" for models without reasoning
# AI_MAX_OUTPUT_TOKENS=2000
# AI_TIMEOUT_SECONDS=20
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# AI_MONTHLY_REQUESTS_PER_USER=20

# --- RAG embeddings ---
# Free key from https://aistudio.google.com/apikey. Used to search fund documents.
GEMINI_API_KEY=

# --- Mail ---
# Leave MAIL_HOST/USERNAME/PASSWORD empty locally: emails go to logs/mail.log instead.
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Hisaab

# Fund compare: the yearly risk-free rate (%) Sharpe and Sortino are measured against.
COMPARE_RISK_FREE_RATE=6.5
