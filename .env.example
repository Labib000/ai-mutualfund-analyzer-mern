# --- App ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173

# --- Logging ---
# LOG_LEVEL=info
# Also write logs to a file (from the repo root). Default in development: logs/server.log. Empty = off.
# LOG_FILE=logs/server.log

# --- Database (MongoDB Atlas) ---
# Atlas → Connect → Drivers. Put the database name (hisaab) after ".net/".
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/hisaab?retryWrites=true&w=majority&appName=Cluster0

# --- Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ---
# Required, at least 32 characters. Signs session cookies and email links.
SESSION_SECRET=
CRON_SECRET=

# --- AI (Phase 4) ---
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=

# --- Mail ---
# Leave MAIL_HOST/USERNAME/PASSWORD empty locally: emails go to logs/mail.log instead.
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Hisaab
